[Unit]
Description=Show Claude Code subagents in the herdr sidebar (claude-herdr-subagents)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/claude-herdr-subagents
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
