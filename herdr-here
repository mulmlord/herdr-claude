#!/bin/bash
# herdr-here: open the focused terminal's folder in the main herdr window, the Pasture
# (see herdr-open), and bring that forward. Omarchy's SUPER+CTRL+RETURN opens a plain
# herdr terminal each time; bind this instead. A herdr terminal only opens when no
# herdr window exists yet.
herdr-open "$(omarchy-cmd-terminal-cwd)" > /dev/null
(($? == 3)) || exit 0
exec omarchy-launch-terminal herdr
