#!/bin/bash
# claude-herdr-tabs: Claude Code hook for sessions running in herdr. It records when a
# subagent starts or stops and when a background shell starts; the watcher
# (claude-herdr-subagents) turns that into tiles in the session's tab: one per agent,
# colored and shaped by its family and generation, shells beside their agent.
#
# Hooks in ~/.claude/settings.json:
#   SubagentStart                   claude-herdr-tabs agent-start
#   SubagentStop                    claude-herdr-tabs agent-stop
#   PostToolUse, matcher Bash       claude-herdr-tabs shell
# Outside herdr (no HERDR_PANE_ID) it returns at once; inside it writes one small
# event file and returns.
input=$(cat)
[[ -n ${HERDR_PANE_ID:-} ]] || exit 0
event=${1:-}
[[ $event != shell || $input == *'"backgroundTaskId"'* ]] || exit 0

state=${XDG_RUNTIME_DIR:-/tmp/claude-herdr-$UID}/claude-herdr/events
mkdir -p "$state" || exit 0

# The claude process this hook runs for: the first ancestor named claude.
p=$PPID cpid=0
while ((p > 1)); do
  read -r comm < "/proc/$p/comm" 2> /dev/null || break
  [[ $comm == claude ]] && { cpid=$p; break; }
  { stat=$(< "/proc/$p/stat"); } 2> /dev/null || break
  read -ra fields <<< "${stat##*) }"
  p=${fields[1]}
done

name=$(date +%s%N)-$event-$$
printf '{"event":"%s","pane":"%s","sock":"%s","cpid":%d,"input":%s}\n' \
  "$event" "$HERDR_PANE_ID" "${HERDR_SOCKET_PATH:-}" "$cpid" "${input:-null}" > "$state/.$name" &&
  mv "$state/.$name" "$state/$name.json"
exit 0
