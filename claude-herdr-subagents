#!/usr/bin/python3 -I
"""claude-herdr-subagents: show Claude Code's subagents in herdr's sidebar.

Claude Code runs its subagents (Agent tool, forks, workflow agents) inside the
session's own process, so herdr only ever sees one agent per pane. This watcher
fills in the rest: for every Claude session running in a herdr pane it reports
that session's running subagents as display-only pane metadata tokens, which
the Claude sidebar layout in ~/.config/herdr/config.toml
([ui.sidebar.agents.rows_by_agent] claude) shows under the session's entry:

  $subs             "3 agents · 1 shell" after the agent name
  $sa1 … $sa5       "├ <description>", one row per subagent, indented by depth
  $sa1do … $sa5do   "│  4m · <tool> <detail>", how long it runs and what it does now
  $sa_more          "└ +2 more"

The list comes from the claude-sessions bar widget's sessions.sh, which reads
running subagents and background shells from the transcripts. Herdr drops
unreported tokens, and rows left without tokens, so nothing shows while a
session has no subagents. Every report carries a TTL and is renewed while
unchanged, so the rows also go away if this watcher stops.

Grind loops (headless claude -p sessions named <loop>-<n>, run by a service)
get a tab per loop in their project's space: see loop_tabs below.

It also shows where each space's folder lies (token $path, rendered under the
space's name by [ui.sidebar.spaces] in the herdr config), and names herdr's tabs
instead of leaving them numbered: after the Claude
session's title for a tab with Claude in it, else after its directory (see
name_tabs below).

Idle cost is a glance at ~/.claude/sessions plus two requests to herdr per poll:
sessions.sh only runs while some Claude process lives in a herdr pane
(HERDR_PANE_ID in its environment).

Usage: claude-herdr-subagents [--once]   (--once: one pass, print what it sends)
"""
import glob
import json
import re
import os
import socket
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CONFIG = os.environ.get("CLAUDE_CONFIG_DIR") or f"{HOME}/.claude"
SESSIONS_DIR = f"{CONFIG}/sessions"
XDG_CONFIG = os.environ.get("XDG_CONFIG_HOME") or f"{HOME}/.config"
SESSIONS_SH = f"{XDG_CONFIG}/omarchy/plugins/mulm.claude-sessions/sessions.sh"
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or f"{HOME}/.cache", "mulm.claude-sessions")
CACHE_FRESH_MS = 4000  # a live.json this fresh is used as is
DEFAULT_SOCKET = f"{XDG_CONFIG}/herdr/herdr.sock"
SOURCE = "user:claude-subagents"
POLL = 1.5        # s; sessions.sh shares a result for 1.5 s with the bar widgets
ROWS = 5          # subagents with rows of their own; the rest are "+N more"
TTL_MS = 30_000   # tokens vanish this long after the last report
REFRESH = 10      # s; renew the TTL of unchanged tokens this often
PAD = "\u2800"  # braille blank: looks like a space, but herdr does not trim it
PROJECTS = os.path.realpath(os.environ.get("CLAUDE_HERDR_PROJECTS") or f"{HOME}/Projects")
HERE = os.path.dirname(os.path.realpath(__file__))
STATE_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "claude-herdr")
LOOP_MIN_AGE = 30  # s a headless session runs before its loop gets a tab
TAB_MAX = 24      # tab names are cut to this many characters
NAMED = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "claude-herdr", "tab-names.json")
TOKENS = ["subs", "sa_more"] + [f"sa{i}{s}" for i in range(1, ROWS + 1) for s in ("", "do")]


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def proc_start(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            return f.read().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


_env = {}  # (pid, start) -> (socket, pane) or None


def herdr_pane(pid):
    start = proc_start(pid)
    if start is None:
        return None
    key = (pid, start)
    if key not in _env:
        try:
            with open(f"/proc/{pid}/environ", "rb") as f:
                env = dict(v.split(b"=", 1) for v in f.read().split(b"\0") if b"=" in v)
        except OSError:
            return None
        pane = env.get(b"HERDR_PANE_ID")
        sock = env.get(b"HERDR_SOCKET_PATH")
        _env[key] = (sock.decode() if sock else DEFAULT_SOCKET, pane.decode()) if pane else None
        if len(_env) > 512:
            _env.clear()
    return _env[key]


def herdr_sessions():
    """pid -> (socket, pane) for every live Claude process in a herdr pane."""
    out = {}
    for path in glob.glob(f"{SESSIONS_DIR}/*.json"):
        try:
            pid = int(os.path.basename(path)[:-5])
        except ValueError:
            continue
        where = herdr_pane(pid)
        if where:
            out[pid] = where
    return out


def widget_sessions():
    """sessions.sh's result. The bar widget runs it every couple of seconds and leaves it in
    live.json (time in live.stamp), so a fresh copy is read from there; sessions.sh itself
    only runs when the bar doesn't (its recomputes on growing transcripts are the costly part)."""
    try:
        with open(f"{CACHE}/live.stamp") as f:
            at = int(f.read().strip())
        if time.time() * 1000 - at < CACHE_FRESH_MS:
            with open(f"{CACHE}/live.json") as f:
                data = json.load(f)
            if isinstance(data, list):
                return data
    except (OSError, ValueError):
        pass
    try:
        r = subprocess.run([SESSIONS_SH], capture_output=True, text=True, timeout=15, cwd=HOME)
        data = json.loads(r.stdout)
        return data if isinstance(data, list) else None
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def age(ms, now):
    if not isinstance(ms, (int, float)):
        return ""
    m = int(max(0, now * 1000 - ms) // 60000)
    return "<1m" if m < 1 else f"{m}m" if m < 60 else f"{m // 60}h{m % 60:02d}"


def plural(n, word):
    return f"{n} {word}{'' if n == 1 else 's'}"


def tokens_for(s, now):
    agents = [a for a in s.get("agents") or [] if isinstance(a, dict)]
    shells = s.get("shells") or []
    t = {}
    parts = ([plural(len(agents), "agent")] if agents else []) + ([plural(len(shells), "shell")] if shells else [])
    if parts:
        t["subs"] = " · ".join(parts)
    shown, more = agents[:ROWS], max(0, len(agents) - ROWS)
    for i, a in enumerate(shown, 1):
        last = i == len(shown) and not more
        # herdr trims leading whitespace (no-break spaces too) from token values
        indent = PAD * 2 * max(0, (a.get("depth") or 1) - 1)
        t[f"sa{i}"] = f"{indent}{'└' if last else '├'} {a.get('description') or a.get('type') or 'agent'}"
        act = a.get("action") or {}
        doing = " ".join(str(x) for x in (act.get("tool"), act.get("detail")) if x) or "starting"
        when = age(a.get("startedAt"), now)
        t[f"sa{i}do"] = f"{indent}{PAD if last else '│'}{PAD * 2}{when + ' · ' if when else ''}{doing}"
    if more:
        t["sa_more"] = f"└ +{more} more"
    return t


def call(sock_path, method, params):
    """One request on herdr's socket: the result, or None (logged when herdr says why)."""
    req = {"id": f"{SOURCE}:{time.time_ns()}", "method": method, "params": params}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.settimeout(1.0)
            c.connect(sock_path)
            c.sendall((json.dumps(req) + "\n").encode())
            buf = b""
            while b"\n" not in buf:
                chunk = c.recv(65536)
                if not chunk:
                    break
                buf += chunk
        resp = json.loads(buf.split(b"\n", 1)[0] or b"{}")
    except (OSError, ValueError):
        return None
    if resp.get("error"):
        log(f"{method} {params.get('pane_id') or params.get('tab_id') or ''}: {resp['error']}")
        return None
    return resp.get("result") or {}


def report(sock_path, pane, tokens):
    return call(sock_path, "pane.report_metadata",
                {"pane_id": pane, "source": SOURCE, "agent": "claude", "tokens": tokens,
                 "ttl_ms": TTL_MS, "seq": time.time_ns()}) is not None


# --- tab names -----------------------------------------------------------------
# herdr numbers tabs it isn't told a name for. A tab with Claude in it is named
# after the Claude session's title (what Claude writes as its terminal title), any
# other after the directory of its first pane, like tmux's automatic-rename. Only
# tabs still carrying their number, or the name this watcher gave them, are renamed:
# a name set by hand stays.

def tab_name(panes):
    claude = [p for p in panes if p.get("agent") == "claude"]
    if claude:
        name = (claude[0].get("terminal_title_stripped") or "").strip() or "claude"
    else:
        d = (panes[0].get("foreground_cwd") or panes[0].get("cwd") or "").rstrip("/")
        name = "~" if d == HOME else os.path.basename(d) or d
    return name if len(name) <= TAB_MAX else name[: TAB_MAX - 1] + "…"


def load_named():
    try:
        with open(NAMED) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def name_tabs(sock_path, panes, named):
    """Rename this server's auto-named tabs; `named` maps tab ids to the names given."""
    tabs = (call(sock_path, "tab.list", {}) or {}).get("tabs")
    if tabs is None:
        return False
    by_tab = {}
    for p in panes:
        by_tab.setdefault(p.get("tab_id"), []).append(p)
    changed = False
    for t in tabs:
        tid, label = t.get("tab_id"), str(t.get("label") or "")
        if label != named.get(tid) and not label.isdigit():
            if named.pop(tid, None) is not None:  # renamed by hand since
                changed = True
            continue
        want = tab_name(by_tab.get(tid) or [{}])
        if want and want != label and call(sock_path, "tab.rename", {"tab_id": tid, "label": want}) is not None:
            named[tid] = want
            changed = True
    gone = set(named) - {t.get("tab_id") for t in tabs}
    for tid in gone:
        del named[tid]
    return changed or bool(gone)


# --- space paths ---------------------------------------------------------------
# Each space shows where its folder lies, as the token $path under its name. The
# folder is the project directory (as herdr-project-space defines it) of the
# space's pane whose project is named like the space, else of its first pane.

def project_dir(d):
    d = d.rstrip("/") or "/"
    if d.startswith(PROJECTS + "/"):
        return os.path.join(PROJECTS, d[len(PROJECTS) + 1:].split("/", 1)[0])
    return d


def tilde(d):
    return "~" + d[len(HOME):] if d == HOME or d.startswith(HOME + "/") else d


def space_paths(sock_path, panes, shown):
    """Report each space's folder as $path; `shown` maps workspace ids to (path, when reported)."""
    spaces = (call(sock_path, "workspace.list", {}) or {}).get("workspaces")
    if spaces is None:
        return
    by_ws = {}
    for p in panes:
        d = p.get("cwd") or p.get("foreground_cwd")
        if d:
            by_ws.setdefault(p.get("workspace_id"), []).append(project_dir(d))
    now = time.time()
    for w in spaces:
        wid, dirs = w.get("workspace_id"), by_ws.get(w.get("workspace_id")) or []
        if not dirs:
            continue
        label = str(w.get("label") or "")
        if label and "/" not in label and os.path.isdir(os.path.join(PROJECTS, label)):
            path = tilde(os.path.join(PROJECTS, label))  # a project's space, wherever its panes are
        else:
            named = [d for d in dirs if os.path.basename(d) == label]
            path = tilde((named or dirs)[0])
        old = shown.get(wid)
        if old and old[0] == path and now - old[1] < REFRESH:
            continue
        if call(sock_path, "workspace.report_metadata",
                {"workspace_id": wid, "source": SOURCE, "tokens": {"path": path}, "ttl_ms": TTL_MS}) is not None:
            shown[wid] = (path, now)
    for wid in set(shown) - {w.get("workspace_id") for w in spaces}:
        del shown[wid]


# --- grind loops ---------------------------------------------------------------
# Headless Claude sessions (claude -p in a service, no terminal) named <loop>-<n>,
# one per iteration, as grind loops start them, get one tab per loop in their
# project's space: claude-herdr-view follows whichever session of the loop runs,
# beside the journal of the unit that drives the loop (<unit>.service for sessions
# running as <unit>-s<n>.service). The view closes the tab once the loop has
# stopped; a loop tab closed by hand stays closed while that loop runs.

def headless_loops():
    """loop name -> {"cwd", "unit"} for live headless sessions named <loop>-<n>."""
    loops, now_ms = {}, time.time() * 1000
    for path in glob.glob(f"{SESSIONS_DIR}/*.json"):
        try:
            pid = int(os.path.basename(path)[:-5])
            with open(path) as f:
                d = json.load(f)
            with open(f"/proc/{pid}/stat") as f:
                tty_nr = int(f.read().rsplit(")", 1)[1].split()[4])
        except (OSError, ValueError, IndexError):
            continue
        m = re.fullmatch(r"(.+)-\d+", str(d.get("name") or ""))
        if tty_nr or not m or herdr_pane(pid) or now_ms - (d.get("startedAt") or now_ms) < LOOP_MIN_AGE * 1000:
            continue
        unit = None
        try:
            with open(f"/proc/{pid}/cgroup") as f:
                u = re.fullmatch(r"(.+)-s\d+\.service", f.read().strip().rsplit("/", 1)[-1])
            unit = u and u.group(1) + ".service"
        except OSError:
            pass
        loops.setdefault(m.group(1), {"cwd": d.get("cwd") or HOME, "unit": unit})
    return loops


def unit_active(unit):
    r = subprocess.run(["systemctl", "--user", "is-active", unit], capture_output=True, text=True)
    return r.stdout.strip() in ("active", "activating", "reloading")


def herdr_cli(*args):
    r = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=10)
    try:
        return json.loads(r.stdout).get("result") or {}
    except ValueError:
        return {}


def open_loop_tab(name, info, state):
    r = subprocess.run([os.path.join(HERE, "herdr-project-space"), info["cwd"]], capture_output=True, text=True)
    ws = (r.stdout.split() or [None])[0]
    if not ws:
        return None
    pane = (herdr_cli("tab", "create", "--workspace", ws, "--cwd", info["cwd"], "--label", name, "--no-focus")
            .get("root_pane") or {}).get("pane_id")
    if not pane:
        return None
    spec = os.path.join(STATE_DIR, f"view.{time.time_ns()}.json")
    with open(spec, "w") as f:
        json.dump({"mode": "loop", "group": name, "unit": info["unit"], "state": state}, f)
    view = os.path.join(HERE, "claude-herdr-view")
    herdr_cli("pane", "run", pane, f"exec {view} {spec}")
    if info["unit"]:
        side = (herdr_cli("pane", "split", pane, "--direction", "right", "--ratio", "0.62",
                          "--cwd", info["cwd"], "--no-focus").get("pane") or {}).get("pane_id")
        if side:
            herdr_cli("pane", "run", side, f"exec journalctl --user -fu {info['unit']} -o cat -n 30")
            herdr_cli("pane", "rename", side, "journal")
    return pane


def loop_tabs(pane_ids, checked):
    """Open a tab for every running loop that has none; `checked` rate-limits unit checks."""
    loops = headless_loops()
    os.makedirs(STATE_DIR, exist_ok=True)
    for name, info in loops.items():
        state = os.path.join(STATE_DIR, "loop-" + re.sub(r"[^A-Za-z0-9_.-]", "_", name) + ".json")
        try:
            with open(state) as f:
                rec = json.load(f)
        except (OSError, ValueError):
            rec = None
        if rec and (rec.get("pane") in pane_ids or rec.get("dismissed")):
            continue
        if rec:  # its pane is gone without the loop ending: closed by hand
            rec["dismissed"] = True
        else:
            pane = open_loop_tab(name, info, state)
            if not pane:
                continue
            rec = {"pane": pane, "loop": name, "unit": info["unit"]}
        rec["seen"] = time.time()
        with open(state, "w") as f:
            json.dump(rec, f)
    # Loops seen no more: forget them once stopped, so a new run gets a tab again.
    now = time.time()
    for state in glob.glob(os.path.join(STATE_DIR, "loop-*.json")):
        try:
            with open(state) as f:
                rec = json.load(f)
        except (OSError, ValueError):
            continue
        if rec.get("loop") in loops:
            continue
        unit = rec.get("unit")
        if unit:
            if now - checked.get(unit, 0) < 30:
                continue
            checked[unit] = now
            if unit_active(unit):
                continue
        elif now - rec.get("seen", now) < 900:
            continue
        if rec.get("dismissed") or rec.get("pane") not in pane_ids:
            os.unlink(state)


def main():
    once = "--once" in sys.argv[1:]
    sent = {}     # (socket, pane) -> tokens last accepted
    renewed = {}  # (socket, pane) -> when the full set was last sent
    named = load_named()  # socket -> {tab id: name given}
    shown = {}            # socket -> {workspace id: (path, when reported)}
    checked = {}          # loop driver unit -> when its state was last checked
    while True:
        now = time.time()
        want = {}
        live = herdr_sessions()
        dirty = False
        for sock_path in {DEFAULT_SOCKET} | {where[0] for where in live.values()}:
            panes = (call(sock_path, "pane.list", {}) or {}).get("panes")
            if panes is None:
                continue
            dirty |= name_tabs(sock_path, panes, named.setdefault(sock_path, {}))
            space_paths(sock_path, panes, shown.setdefault(sock_path, {}))
            if sock_path == DEFAULT_SOCKET and not once:
                try:
                    loop_tabs({p.get("pane_id") for p in panes}, checked)
                except (OSError, subprocess.SubprocessError) as e:
                    log(f"loop tabs: {e!r}")
        if dirty and not once:
            os.makedirs(os.path.dirname(NAMED), exist_ok=True)
            with open(NAMED + ".tmp", "w") as f:
                json.dump(named, f)
            os.replace(NAMED + ".tmp", NAMED)
        if live:
            for where in live.values():
                want.setdefault(where, {})
            for s in widget_sessions() or []:
                where = live.get(s.get("pid"))
                if where:
                    want[where] = tokens_for(s, now)
        for key in set(sent) | set(want):
            new, old = want.get(key, {}), sent.get(key, {})
            if new and now - renewed.get(key, 0) >= REFRESH:
                patch = dict(new)  # renew every TTL
            else:
                patch = {k: v for k, v in new.items() if old.get(k) != v}
            patch.update({k: None for k in TOKENS if k in old and k not in new})
            if not patch:
                continue
            if once:
                print(json.dumps({"pane": key[1], "tokens": patch}, ensure_ascii=False))
            if report(*key, patch):
                if new:
                    sent[key] = new
                    if patch.keys() >= new.keys():
                        renewed[key] = now
                else:
                    sent.pop(key, None)
                    renewed.pop(key, None)
            elif key not in want:
                sent.pop(key, None)  # pane or server gone; the TTL clears the rest
                renewed.pop(key, None)
        if once:
            return 0
        time.sleep(POLL)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
